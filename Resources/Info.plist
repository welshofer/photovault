<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard app keys (Xcode fills most of these) -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    
    <key>CFBundleVersion</key>
    <string>1</string>
    
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    
    <!-- REQUIRED: Photos library usage description -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>PhotoVault needs access to your Photos library to back up your photos and videos to Google Drive.</string>
    
    <!-- URL scheme for OAuth callback -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.yourname.photovault.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <!-- IMPORTANT: Replace with your actual bundle identifier -->
                <string>com.yourname.photovault</string>
            </array>
        </dict>
    </array>
    
    <!-- App category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.photography</string>
    
    <!-- High resolution capable -->
    <key>NSHighResolutionCapable</key>
    <true/>
    
    <!-- Supports secure coding -->
    <key>NSSupportsSecureStateCoding</key>
    <true/>
</dict>
</plist>
